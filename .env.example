NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_SUPABASE_SECRET_KEY=

# Required in production. Canonical HTTPS origin used in all emailed secret links.
# Do not include a path, query string, fragment, or credentials.
NEXT_PUBLIC_APP_URL=https://besh-crm.vercel.app

# Public deep-link origin for the installed mobile app, when configured.
NEXT_PUBLIC_MOBILE_APP_URL=beshfuel://

# Application invitations are delivered through the Resend HTTP API.
RESEND_API_KEY=
APPLICATION_INVITATION_FROM_EMAIL=

# Server-only WEX SOAP integration and durable worker authorization.
WEX_API_USERNAME=
WEX_API_PASSWORD=
WEX_SOAP_ENDPOINT_URL=
WEX_HTTP_PROXY=
WEX_CARD_FINGERPRINT_SECRET=
WEX_WORKER_SECRET=
